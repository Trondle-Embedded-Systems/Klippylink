# ─────────────────────────────────────────────────────────────────────────────
# KlippyLink printer.cfg example
# Copy the relevant sections into your printer.cfg and adjust values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Router / linux-host API (one per KlippyLink mesh) ────────────────────────
[klippylink router]
# URL of the linux-host API service running on the same machine as Klipper.
# Default: http://localhost:8080
api_url: http://localhost:8080


# ── NeoPixel strip on a node ─────────────────────────────────────────────────
[klippylink_neopixel toolhead_leds]
router:  router             # matches [klippylink router] above
node:    toolhead_node      # device_name in node's config.json
strip:   status_leds        # strip name in node's config.json
count:   8                  # number of LEDs (informational)

# GCode usage:
#   SET_KLIPPYLINK_LED STRIP=toolhead_leds RED=1 GREEN=0 BLUE=0        (all red)
#   SET_KLIPPYLINK_LED STRIP=toolhead_leds RED=0 GREEN=1 BLUE=0 INDEX=3 (one pixel)


# ── Endstop on a node ────────────────────────────────────────────────────────
[klippylink_endstop x_min_ext]
router:   router
node:     toolhead_node
endstop:  x_min

# GCode usage:
#   QUERY_KLIPPYLINK_ENDSTOP ENDSTOP=x_min_ext


# ── PID heater on a VARIANT_FULL node (ESP32-S3) ─────────────────────────────
[klippylink_heater chamber_heater]
router:      router
node:        toolhead_node
target_temp: 0.0    # set via SET_HEATER_TEMPERATURE at runtime
kp:          1.0
ki:          0.1
kd:          0.01


# ── Heater emergency macro — fires if BLE heartbeat times out ────────────────
[gcode_macro KLIPPYLINK_HEATER_EMERGENCY]
description: Emergency stop triggered by KlippyLink BLE heartbeat timeout
gcode:
    M112  ; emergency stop


# ── Example macro — rainbow idle animation ───────────────────────────────────
[gcode_macro KLIPPYLINK_RAINBOW]
description: Cycle LEDs through colours
gcode:
  {% set steps = [
    (1,0,0),(1,0.5,0),(1,1,0),(0,1,0),(0,1,1),(0,0,1),(0.5,0,1)
  ] %}
  {% for r,g,b in steps %}
    SET_KLIPPYLINK_LED STRIP=toolhead_leds RED={r} GREEN={g} BLUE={b}
    G4 P200
  {% endfor %}
  SET_KLIPPYLINK_LED STRIP=toolhead_leds RED=0 GREEN=0 BLUE=0
